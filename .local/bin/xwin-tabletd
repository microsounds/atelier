#!/usr/bin/env sh

# xwin-tabletd v0.3
# rotates display and digitizer input based on accelerometer

# detect primary device display
# on multi-monitor setups, only primary display should rotate/transform
dpy="$(xrandr | grep '[^dis]connected' | tr -s ' ' '\t' | cut -f1 | head -n 1)"

# detect digitizer devices
dpy_digitizer="$(xinput list --name-only | grep -i wacom)"
[ ! -z "$dpy_digitizer" ] || exit 0

# detect laptop mouse pointer devices
ptr_devices="$(xinput list --name-only | egrep -i '(touchpad|trackpoint)')"

abort() {
	kill $!
	rm -rf "$R_FIFO"
}
trap abort 0 1 2 3 6 15

# workarounds for iio-sensor-proxy
# repeatedly poke sensor on a timer to avoid aggressive battery optimization
while :; do
	cat /sys/bus/iio/devices/iio:device0/in_accel_x_raw > /dev/null
	sleep 2
done &

# rotation FIFO for external control via sxhkd
R_FIFO="$XDG_RUNTIME_DIR/.rotate.$XDG_SESSION_ID"
[ ! -p "$R_FIFO" ] && mkfifo "$R_FIFO"
monitor-sensor >> "$R_FIFO" &

while read -r line; do
	state="${line##* }"
	unset rot mat
	case "$state" in
		normal)    rot='normal';   mat='1 0 0 0 1 0 0 0 1';;
#		right-up)  rot='right';    mat='0 1 0 -1 0 1 0 0 1';;
#		left-up)   rot='left';     mat='0 -1 1 1 0 0 0 0 1';;
		bottom-up) rot='inverted'; mat='-1 0 1 0 -1 1 0 0 1';;
	esac

	if [ ! -z "$rot" ] && [ ! -z "$mat" ]; then
		echo "[${0##*/}]: Rotating display: $rot" | notify-send -t 2
		xrandr --output "$dpy" --rotate "$rot" &

		# launch onscreen keyboard if not already running
#		! ps -e | fgrep -q 'onboard' && [ "$rot" != 'normal' ] && onboard &

		# rotate digitizer matrices
		echo "$dpy_digitizer" | while read -r f; do
			xinput set-prop "$f" 'Coordinate Transformation Matrix' $mat
		done &
		# disable touchpad(s) in tablet mode
		echo "$ptr_devices" | while read -r f; do
				[ "$rot" = "normal" ] && xinput enable "$f" || xinput disable "$f"
		done &
	fi
done < "$R_FIFO"
